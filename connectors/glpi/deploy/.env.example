# Paquet d'installation -- passerelle GLPI <-> rag_core.
# Copier en .env puis remplir. Les URLs internes (pgvector) sont construites par
# docker-compose.yml via le nom de service : rien à saisir pour ça ici.

# --- Accès API GLPI (ton instance, HORS de ce compose) ----------------------------
# host.docker.internal pointe vers la machine hôte (règle extra_hosts du compose,
# cf. docker-compose.yml). Change juste le port si ton GLPI n'écoute pas sur 8080.
GLPI_URL=http://host.docker.internal:8080/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# --- Fournisseur LLM (choisir Mistral OU Gemini) ------------------------------------
# Mistral : laisser MISTRAL_API_KEY seule (defauts catalogue = mistral-small-latest /
# mistral-embed, EMBEDDING_DIMENSION=1024 deja par defaut).
MISTRAL_API_KEY=
# Gemini : remplir GEMINI_API_KEY ET decommenter les 3 lignes RAG_*/EMBEDDING_DIMENSION
# ci-dessous (EMBEDDING_DIMENSION doit correspondre au modele choisi -- ne JAMAIS changer
# sans recreer la table knowledge_chunk, la dimension du vecteur est figee a la creation).
GEMINI_API_KEY=
# RAG_GENERATION_MODEL=gemini-3.5-flash-lite
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=1536

# --- Comportement de la passerelle --------------------------------------------------
# STRICT : seule la valeur littérale "false" désarme le dry-run. Tout le reste => dry-run.
DRY_RUN=true
# 1=nouveau 2=en cours(attribué) 3=en cours(planifié) 4=en attente 5=résolu 6=clos
GLPI_TICKET_STATUS_FILTER=1
POLL_INTERVAL_SECONDS=60

# --- Base Postgres interne (générée par toi, jamais commise) ------------------------
POSTGRES_USER=glpi_gateway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=glpi_gateway
