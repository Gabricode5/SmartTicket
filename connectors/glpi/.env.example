# Connecteur GLPI -- configuration (copie en .env pour le dev local).

# --- Accès API GLPI ---------------------------------------------------------------
GLPI_URL=https://glpi.exemple.local/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_API_VERSION=10
GLPI_HTTP_TIMEOUT=20

# --- Sélection des tickets ------------------------------------------------------
# 1=nouveau 2=en cours(attribué) 3=en cours(planifié) 4=en attente 5=résolu 6=clos
GLPI_TICKET_STATUS_FILTER=1
GLPI_LIST_LIMIT=50

# --- Écriture du suivi --------------------------------------------------------
GLPI_FOLLOWUP_ITEMTYPE=ITILFollowup
FOLLOWUP_IS_PRIVATE=true
SUGGESTION_PREFIX=[Suggestion IA - à valider]
AI_DISCLOSURE=Cette réponse a été rédigée avec l'assistance d'une IA.

# --- Poller -----------------------------------------------------------------
# STRICT : seule la valeur littérale "false" désarme le dry-run. Tout le reste => dry-run.
DRY_RUN=true
# Seul mode supporté (l'IA ne répond jamais directement au client).
RESPONSE_MODE=suggested
POLL_INTERVAL_SECONDS=60

# --- Bases (toutes distinctes de celle de Tiqia) --------------------------
# État du connecteur (processed_tickets).
CONNECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glpi_connector
# Base vectorielle rag_core (cf. rag_core/.env.example).
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
MISTRAL_API_KEY=
# Alternative a Mistral : GEMINI_API_KEY + RAG_GENERATION_MODEL=gemini-3.5-flash-lite +
# RAG_EMBEDDING_MODEL=gemini-embedding-001 + EMBEDDING_DIMENSION=1536 (cf. rag_core/.env.example).
GEMINI_API_KEY=

# Surcouche prompt client transmise à rag_core (facultative).
RAG_CLIENT_PROMPT_OVERLAY=

# --- Tests -----------------------------------------------------------------
# Doit contenir "test". Postgres requis (pgvector pas nécessaire pour ces tables).
CONNECTOR_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/connector_test
