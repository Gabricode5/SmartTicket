# rag_core -- configuration (copie en .env pour le dev local).
# Toutes les valeurs ont un defaut aligne sur le RAG de Tiqia SAUF RAG_DATABASE_URL.

# --- Base vectorielle dediee (OBLIGATOIRE) --------------------------------------------
# Postgres + extension pgvector. JAMAIS la base de Tiqia : instance dediee, provisionnee
# avec l'installation client (on-premise) ou un Postgres local en dev.
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# Mono-tenant strict : laisser tel quel (valeur fixe, jamais filtree).
RAG_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Modeles (catalogue FERME : mistral-small-latest | mistral-large-latest | mistral-embed) -
# Laisser vide = defaut du catalogue (mistral-small-latest / mistral-embed).
RAG_GENERATION_MODEL=
RAG_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
RAG_REQUEST_TIMEOUT=30

# --- Retrieval + reranking ----------------------------------------------------------
KB_TOP_K=4
KB_MAX_CONTEXT_CHARS=3000
RERANK_FETCH_MULTIPLIER=3
RERANK_LEXICAL_WEIGHT=0.3
RERANK_FEEDBACK_WEIGHT=0.2
RERANK_QUARANTINE_THRESHOLD=-3
RAG_LOW_CONFIDENCE_DISTANCE=0.4

# --- Ingestion (rag_core/ingest.py) -- memes defauts que backend/ingest_postgres.py -
INGEST_CHUNK_SIZE=1000
INGEST_CHUNK_OVERLAP=100
MIN_TEXT_LENGTH=80
CHUNK_QUALITY_THRESHOLD=0.4
MAX_KB_CHUNKS=80
EMBED_BATCH_SIZE=8
SCRAPE_TIMEOUT=10
INGEST_USER_AGENT=Mozilla/5.0
RAG_INGEST_DEFAULT_CATEGORY=documentation

# --- Prompt : surcouche client (couche 2) -----------------------------------------
# Personnalisation par installation (ton, langue, formules, perimetre). NE PEUT PAS
# ecraser les garde-fous de la couche 1 (ordre impose + sanitisation, cf. prompt.py).
# Vide = comportement generique.
RAG_CLIENT_PROMPT_OVERLAY=

# --- Fournisseur Mistral ----------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_MAX_RETRIES=5
MISTRAL_BACKOFF_SECONDS=2

# --- Fournisseur Gemini (Google) -- alternative a Mistral --------------------------
# Pour l'utiliser : RAG_GENERATION_MODEL=gemini-3.5-flash-lite,
# RAG_EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIMENSION=1536 (dimension choisie
# pour gemini-embedding-001, voir rag_core/llm/catalogue.py -- output_dimensionality
# configurable, 1536 est une valeur recommandee par Google).
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MAX_RETRIES=5
GEMINI_BACKOFF_SECONDS=2

# --- Fournisseur Claude (Anthropic) -- generation uniquement, pas d'API d'embeddings ----
# Pour l'utiliser : RAG_GENERATION_MODEL=claude-haiku-5-5 (garder un AUTRE fournisseur
# pour RAG_EMBEDDING_MODEL, ex: gemini-embedding-001 ou mistral-embed).
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_RETRIES=5
ANTHROPIC_BACKOFF_SECONDS=2

# --- Fournisseur OpenAI ------------------------------------------------------------
# Pour l'utiliser : RAG_GENERATION_MODEL=gpt-6-luna, RAG_EMBEDDING_MODEL=text-embedding-3-small,
# EMBEDDING_DIMENSION=1536.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MAX_RETRIES=5
OPENAI_BACKOFF_SECONDS=2

# --- Fournisseur local (Ollama par defaut) ------------------------------------------
# Pour l'utiliser : RAG_GENERATION_MODEL=llama3.1 (apres `ollama pull llama3.1`),
# RAG_EMBEDDING_MODEL=nomic-embed-text (apres `ollama pull nomic-embed-text`),
# EMBEDDING_DIMENSION=768. Pour viser un autre serveur local compatible OpenAI (vLLM,
# LM Studio...) : changer OLLAMA_API_URL -- meme code, pas de nouveau fournisseur a ecrire.
OLLAMA_API_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MAX_RETRIES=3
OLLAMA_BACKOFF_SECONDS=1

# --- Tests -----------------------------------------------------------------------
# Doit contenir "test" (garde-fou anti-ecrasement). Postgres+pgvector requis.
RAG_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db
