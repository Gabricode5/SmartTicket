# rag_core -- configuration (copie en .env pour le dev local).
# Toutes les valeurs ont un defaut aligne sur le RAG de Tiqia SAUF RAG_DATABASE_URL.

# --- Base vectorielle dediee (OBLIGATOIRE) --------------------------------------------
# Postgres + extension pgvector. JAMAIS la base de Tiqia : instance dediee, provisionnee
# avec l'installation client (on-premise) ou un Postgres local en dev.
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# Mono-tenant strict : laisser tel quel (valeur fixe, jamais filtree).
RAG_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Modeles (catalogue FERME : mistral-small-latest | mistral-large-latest | mistral-embed) -
# Laisser vide = defaut du catalogue (mistral-small-latest / mistral-embed).
RAG_GENERATION_MODEL=
RAG_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
RAG_REQUEST_TIMEOUT=30

# --- Retrieval + reranking ----------------------------------------------------------
KB_TOP_K=4
KB_MAX_CONTEXT_CHARS=3000
RERANK_FETCH_MULTIPLIER=3
RERANK_LEXICAL_WEIGHT=0.3
RERANK_FEEDBACK_WEIGHT=0.2
RERANK_QUARANTINE_THRESHOLD=-3
RAG_LOW_CONFIDENCE_DISTANCE=0.4

# --- Prompt : surcouche client (couche 2) -----------------------------------------
# Personnalisation par installation (ton, langue, formules, perimetre). NE PEUT PAS
# ecraser les garde-fous de la couche 1 (ordre impose + sanitisation, cf. prompt.py).
# Vide = comportement generique.
RAG_CLIENT_PROMPT_OVERLAY=

# --- Fournisseur Mistral ----------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_MAX_RETRIES=5
MISTRAL_BACKOFF_SECONDS=2

# --- Tests -----------------------------------------------------------------------
# Doit contenir "test" (garde-fou anti-ecrasement). Postgres+pgvector requis.
RAG_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db
